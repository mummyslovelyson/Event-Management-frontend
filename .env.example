# Base URL of the deployed backend API (no trailing slash).
# Example: https://trip-and-cliqs-backend.onrender.com/api
VITE_API_URL=https://trip-and-cliqs-backend.onrender.com/api

# Firebase Web App Configuration (for OAuth / Google Sign-in)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google OAuth Client ID (optional GIS fallback)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Mapbox GL Access Token (for live interactive event discovery map)
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
